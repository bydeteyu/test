{
  "version": 2,
  "builds": [
    {
      "src": "web/app.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "50mb" }
    },
    {
      "src": "web/static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/web/static/$1" },
    { "src": "/(.*)", "dest": "/web/app.py" }
  ],
  "functions": {
    "web/app.py": {
      "maxDuration": 300
    }
  }
}
